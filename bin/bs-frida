#!/bin/bash
# Push (if needed) and run frida-server as root on BlueStacks Air.
# Usage: bs-frida [up|down|status] [--server /path/to/frida-server-arm64]
set -euo pipefail
. "$(dirname "$0")/bs-env.sh"

CMD="${1:-up}"
SERVER_LOCAL=""
[ "${2:-}" = "--server" ] && SERVER_LOCAL="${3:-}"
REMOTE=/data/local/tmp/frida-server-rootstacks

bs_connect
bs_has_root || { echo "ERROR: no root — run bs-root first" >&2; exit 1; }

case "$CMD" in
  up)
    if [ -n "$SERVER_LOCAL" ]; then
      bsadb push "$SERVER_LOCAL" "$REMOTE" >/dev/null
    elif ! bsadb shell "ls $REMOTE" >/dev/null 2>&1; then
      # fall back to any staged frida-server
      EXIST=$(bsadb shell 'ls /data/local/tmp/frida-server-17.17 /data/local/tmp/frida-server-17 /data/local/tmp/frida-server 2>/dev/null | head -1' | tr -d '\r')
      [ -n "$EXIST" ] || { echo "No frida-server found; pass --server <path to android-arm64 frida-server>" >&2; exit 1; }
      bsadb shell "cp $EXIST $REMOTE"
    fi
    bsadb shell "su -c 'chmod 755 $REMOTE; killall -q frida-server-rootstacks 2>/dev/null; nohup $REMOTE >/dev/null 2>&1 &'"
    sleep 1
    bsadb forward tcp:27042 tcp:27042 >/dev/null 2>&1
    echo "frida-server started as root: $(bsadb shell 'su -c "ps -A | grep frida-server-rootstacks"' | tr -d '\r')"
    echo "connect from mac:  frida-ps -H 127.0.0.1:27042"
    ;;
  down)
    bsadb shell "su -c 'killall -q frida-server-rootstacks 2>/dev/null'" || true
    echo "frida-server stopped"
    ;;
  status)
    bsadb shell "ps -A 2>/dev/null | grep frida-server || echo 'not running'"
    ;;
  *) echo "usage: bs-frida [up|down|status] [--server PATH]" >&2; exit 1 ;;
esac

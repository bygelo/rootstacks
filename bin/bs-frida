#!/bin/bash
# Push (if needed) and run frida-server as root on BlueStacks Air.
# Usage: bs-frida [up|down|status|sync] [--server /path/to/frida-server-arm64]
set -euo pipefail
. "$(dirname "$0")/bs-env.sh"

CMD="${1:-up}"
SERVER_LOCAL=""
[ "${2:-}" = "--server" ] && SERVER_LOCAL="${3:-}"
REMOTE=/data/local/tmp/frida-server-rootstacks

bs_connect
bs_has_root || { echo "ERROR: no root — run bs-root first" >&2; exit 1; }

case "$CMD" in
  sync)
    # Match the on-device frida-server to the installed frida CLIENT version.
    CLIENT="$(frida --version 2>/dev/null | tr -d '\r')"
    [ -n "$CLIENT" ] || { echo "frida client not found on PATH" >&2; exit 1; }
    RUNNING="$(bsadb shell 'su -c "/data/local/tmp/frida-server-$(echo '"$CLIENT"' | cut -dx -f1) --version" 2>/dev/null' | tr -d '\r' || true)"
    DEST="/data/local/tmp/frida-server-$CLIENT"
    if bsadb shell "ls $DEST" >/dev/null 2>&1; then
      echo "server already matches client $CLIENT"
    else
      echo "[*] fetching frida-server $CLIENT (android-arm64) to match client"
      TMP="$(mktemp -d)"
      curl -fsSL "https://github.com/frida/frida/releases/download/$CLIENT/frida-server-$CLIENT-android-arm64.xz" -o "$TMP/fs.xz" \
        || { echo "no release for $CLIENT" >&2; exit 1; }
      xz -dkf "$TMP/fs.xz"
      bsadb push "$TMP/fs" "$DEST" >/dev/null
      rm -rf "$TMP"
    fi
    # repoint the persistent module + the canonical -17 name at the matched server
    bsadb shell "su -c '
      chmod 755 $DEST
      cp $DEST /data/local/tmp/frida-server-17 2>/dev/null || true
      sed -i \"s#/data/local/tmp/frida-server-[0-9.]*#$DEST#\" /data/adb/modules/rootstacks-frida/service.sh 2>/dev/null || true
      killall -q \$(basename $DEST) 2>/dev/null
      nohup $DEST >/dev/null 2>&1 &'"
    sleep 1; bsadb forward tcp:27042 tcp:27042 >/dev/null 2>&1
    echo "[✓] synced: server=$CLIENT client=$CLIENT → $(frida-ps -H 127.0.0.1:27042 2>/dev/null | wc -l | tr -d ' ') procs visible"
    ;;
  up)
    # A version mismatch between the on-device server and the Mac frida CLIENT is
    # silent-but-fatal: the client attaches and scripts load, but Interceptor.attach
    # no-ops (hooks report ✓ yet never fire). So pick a server that MATCHES the client.
    # (frida-server-rootstacks shipped 16.5.9; a 17.x client needs a 17.x server —
    # verified 2026-09-08.) Run `bs-frida sync` to fetch an exact match.
    CLIENT="$(frida --version 2>/dev/null | tr -d '\r' || true)"
    if [ -n "$SERVER_LOCAL" ]; then
      bsadb push "$SERVER_LOCAL" "$REMOTE" >/dev/null
      RUN="$REMOTE"
    else
      RUN=""
      # prefer an exact client-version match, then any staged server
      for cand in "/data/local/tmp/frida-server-$CLIENT" "$REMOTE" /data/local/tmp/frida-server-17.17 /data/local/tmp/frida-server-17 /data/local/tmp/frida-server; do
        bsadb shell "ls $cand" >/dev/null 2>&1 || continue
        SV="$(bsadb shell "su -c '$cand --version' 2>/dev/null" | tr -d '\r' || true)"
        if [ -n "$CLIENT" ] && [ "$SV" = "$CLIENT" ]; then RUN="$cand"; break; fi
        [ -z "$RUN" ] && RUN="$cand"   # remember first existing as a fallback
      done
      [ -n "$RUN" ] || { echo "No frida-server found; run 'bs-frida sync' or pass --server <android-arm64 frida-server>" >&2; exit 1; }
      SV="$(bsadb shell "su -c '$RUN --version' 2>/dev/null" | tr -d '\r' || true)"
      if [ -n "$CLIENT" ] && [ "$SV" != "$CLIENT" ]; then
        echo "WARNING: server $RUN is $SV but frida client is $CLIENT — hooks will silently no-op." >&2
        echo "         run 'bs-frida sync' to fetch a matching server." >&2
      fi
    fi
    BN="$(basename "$RUN")"
    bsadb shell "su -c 'chmod 755 $RUN; killall -q $BN frida-server-rootstacks 2>/dev/null; nohup $RUN >/dev/null 2>&1 &'"
    sleep 1
    bsadb forward tcp:27042 tcp:27042 >/dev/null 2>&1
    echo "frida-server started as root: $(bsadb shell "su -c 'ps -A | grep frida-server'" | tr -d '\r')"
    echo "connect from mac:  frida-ps -H 127.0.0.1:27042"
    ;;
  down)
    bsadb shell "su -c 'pkill -q -f frida-server 2>/dev/null; killall -q frida-server-rootstacks 2>/dev/null'" || true
    echo "frida-server stopped"
    ;;
  status)
    bsadb shell "ps -A 2>/dev/null | grep frida-server || echo 'not running'"
    ;;
  *) echo "usage: bs-frida [up|down|status|sync] [--server PATH]" >&2; exit 1 ;;
esac

#!/bin/bash
# Spawn an app with SSL-pinning bypassed via the bundled frida unpinning script.
# Usage: bs-unpin <package>
set -euo pipefail
. "$(dirname "$0")/bs-env.sh"
PKG="${1:-}"; [ -n "$PKG" ] || { echo "usage: bs-unpin <package>"; exit 1; }
SCRIPT="$REPO_DIR/assets/frida/multiple-unpinning.js"
[ -f "$SCRIPT" ] || { echo "missing $SCRIPT (run: bs-fetch-scripts)"; exit 1; }
bs_connect
"$(dirname "$0")/bs-frida" up >/dev/null 2>&1 || true
bsadb forward tcp:27042 tcp:27042 >/dev/null 2>&1
echo "[*] spawning $PKG with SSL unpinning (Ctrl-C to detach)"
exec frida -H 127.0.0.1:27042 -f "$PKG" -l "$SCRIPT"

# Large / machine-specific artifacts — do not commit
*.quark.log
snapshots/
*.qcow2
*.qcow2.z
assets/*.log
assets/repatch*.log
assets/initrd_hvf.img.orig*

# Third-party binaries — fetched by bin/bs-fetch-assets, not redistributed here
assets/magisk.apk
assets/apk/*.apk
assets/modules/*.zip
vendor/*/magisk.apk

# BlueStacks proprietary boot image backup (generated locally by bs-root; never publish)
initrd_hvf.img*
